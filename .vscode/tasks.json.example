{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Ruff: Check",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/ruff",
      "args": ["check", "."],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Ruff: Format",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/ruff",
      "args": ["format", "."],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Ty: Check",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/ty",
      "args": ["check"],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Pytest: Run All",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/pytest",
      "args": ["-v"],
      "group": "test",
      "problemMatcher": []
    }
  ]
}